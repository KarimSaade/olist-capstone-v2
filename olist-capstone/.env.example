# Copy to .env and change the values. .env is git-ignored and must never be committed.

POSTGRES_USER=capstone
POSTGRES_PASSWORD=change-me-postgres

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change-me-secret

# Password for JupyterLab (any string)
JUPYTER_TOKEN=change-me-jupyter

# Linux only: run `id -u` and put the result here so Airflow can write its logs
AIRFLOW_UID=50000

# Change if something else on your machine already uses 5432
PG_HOST_PORT=5432
